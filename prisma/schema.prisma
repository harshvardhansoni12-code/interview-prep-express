generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id String @id @default(uuid())
  name String @unique
  category String @unique
  price Float
  authorId String
  author User @relation(fields: [authorId], references: [id])
}
